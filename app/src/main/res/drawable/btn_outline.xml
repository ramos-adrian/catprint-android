<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#40808080">
    <item>
        <selector>
            <item android:state_checked="true">
                <shape><solid android:color="@color/accent" /><corners android:radius="10dp" /></shape>
            </item>
            <item>
                <shape>
                    <stroke android:width="1dp" android:color="@color/line" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
